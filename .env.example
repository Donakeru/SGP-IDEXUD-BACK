# Copia este archivo como .env y completa los valores. No subas .env al repositorio.

# --- Aplicación ---
# development | local | staging | production
# La documentación (/docs, /redoc, /openapi.json) solo se publica en development o local.
ENVIRONMENT=development
# Prefijo de todas las rutas y de /docs, /redoc y /openapi.json. Vacío = raíz.
APP_SUBPATH=/api
# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Autenticación (Keycloak es el único modo; las tres son obligatorias) ---
KEYCLOAK_URL=
KEYCLOAK_REALM=
# client_id esperado en los claims aud o azp. Admite varios separados por coma.
KEYCLOAK_AUDIENCE=

# --- Base de datos (PostgreSQL) ---
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
# Opcional. Registra todas las sentencias SQL con sus parámetros (ids, sub).
# Solo tiene efecto si ENVIRONMENT es development o local. Por defecto: desactivado.
# SQL_ECHO=true

# --- Archivos ---
# Carpeta de almacenamiento relativa a la raíz del proyecto.
STORAGE_ROOT=storages
# Tamaño máximo por archivo, en MB.
MAX_UPLOAD_SIZE_MB=10
